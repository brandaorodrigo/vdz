{
    "build": {
        "appId": "vdz",
        "asar": true,
        "compression": "maximum",
        "electronLanguages": [
            "pt-BR"
        ],
        "extraResources": [
            {
                "from": "electron/win-audio.exe",
                "to": "win-audio.exe"
            }
        ],
        "files": [
            "!**/vdz_*.exe"
        ],
        "nsis": {
            "allowToChangeInstallationDirectory": false,
            "artifactName": "vdz_${version}.${ext}",
            "createDesktopShortcut": true,
            "displayLanguageSelector": false,
            "installerLanguages": [
                "pt_BR"
            ],
            "oneClick": true,
            "perMachine": false,
            "shortcutName": "vdz"
        },
        "productName": "vdz",
        "win": {
            "icon": "public/android-chrome-512x512.png",
            "target": [
                "nsis"
            ]
        }
    },
    "dependencies": {
        "express": "^4.21.2",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.7",
        "electron": "^39.2.0",
        "electron-builder": "^26.0.12"
    },
    "main": "electron/main.js",
    "name": "vdz",
    "private": true,
    "scripts": {
        "app": "node electron/build-audio.js && electron .",
        "dist": "node electron/build-audio.js && electron-builder --win nsis",
        "start": "node server.js"
    },
    "version": "2.0.0"
}
