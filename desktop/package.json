{
    "build": {
        "appId": "app.vdz.desktop",
        "compression": "maximum",
        "directories": {
            "output": "dist"
        },
        "electronLanguages": [
            "pt-BR",
            "en-US"
        ],
        "extraResources": [
            {
                "from": "../public/android-chrome-512x512.png",
                "to": "icon.png"
            }
        ],
        "files": [
            "main.js",
            "preload.js",
            "linux-audio.js",
            "package.json"
        ],
        "linux": {
            "artifactName": "vdz_${version}.${ext}",
            "category": "AudioVideo",
            "executableName": "vdz",
            "icon": "../public/android-chrome-512x512.png",
            "synopsis": "transmissor desktop do vdz",
            "target": [
                {
                    "arch": [
                        "x64"
                    ],
                    "target": "AppImage"
                }
            ]
        },
        "nsis": {
            "allowToChangeInstallationDirectory": true,
            "oneClick": false
        },
        "productName": "vdz",
        "win": {
            "artifactName": "vdz_${version}.${ext}",
            "extraResources": [
                {
                    "from": "loopback/publish/vdz-loopback.exe",
                    "to": "vdz-loopback.exe"
                }
            ],
            "icon": "../public/android-chrome-512x512.png",
            "target": [
                {
                    "arch": [
                        "x64"
                    ],
                    "target": "nsis"
                }
            ]
        }
    },
    "description": "transmissor desktop do vdz",
    "devDependencies": {
        "electron": "^35.7.5",
        "electron-builder": "^26.0.12"
    },
    "main": "main.js",
    "name": "vdz-desktop",
    "private": true,
    "productName": "vdz",
    "scripts": {
        "build": "npm run loopback && electron-builder --win nsis --x64",
        "build:linux": "electron-builder --linux AppImage --x64",
        "loopback": "dotnet publish loopback/VdzLoopback.csproj -c Release -o loopback/publish",
        "start": "electron ."
    },
    "version": "1.12"
}
